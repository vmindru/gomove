# Local POC settings; generated secrets are stored only in the ignored .env.compose.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
WEB_BOOTSTRAP=true

APP_NAME=GoMove
APP_ENV=local
APP_KEY=__GENERATE_APP_KEY__
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Prague
APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=gomove
DB_USERNAME=gomove
DB_PASSWORD=__GENERATE_DB_PASSWORD__

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
MAIL_MAILER=log
VITE_APP_NAME=GoMove
